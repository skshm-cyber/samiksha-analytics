# Supabase PostgreSQL connection string
# Format: postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# CORS origins — comma-separated list of allowed frontend domains
# For GitHub Pages: https://yourusername.github.io
CORS_ORIGINS=https://yourusername.github.io

# Environment
ENVIRONMENT=production
